{
  "name": "nexoswap-backend",
  "version": "0.1.0",
  "description": "Backend service for the NexoSwap MVP. Provides RESTful APIs for authentication, trading, compliance and admin functions.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "argon2": "^0.31.0",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^2.4.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.1",
    "uuid": "^9.0.0"
    ,"morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/src/tests"]
  },
  "knex": {
    "client": "pg",
    "migrations": {
      "directory": "src/db/migrations"
    },
    "seeds": {
      "directory": "src/db/seeds"
    }
  }
}